# mbport never ships anything that belongs to the game, the console or a player. Everything below
# stays on your own disk. LEGAL.md says why.

# --- Game files, updates, add-ons and dumps ------------------------------------------------------
# Game folders (CUSA18758, CUSA18758-full, CUSA18758-patch, ...), also when they are symlinks
/CUSA*
CUSA*/
*.pkg
eboot.bin
param.sfo
sce_discmap.plt
sce_sys/
sce_module/
*.prx
*.sprx
*.self
*.elf
*.at9
*.trp
*.dcx
*.7z
*.zip
*.mp4
# Memory images and frame dumps taken while debugging
*.raw
img.bin
/addcont/

# --- Saves, players' data and keys --------------------------------------------------------------
# A checkout's own user folder (saves, title storage, trophies, shader cache) and scratch copies
user/
/user*/
savedata/
tus/
*.sav
# Settings and environment files: they can hold paths, names and keys (the trophy key)
bbport.ini
*.ini
.env
.env.*
*.env
*.key
*keys.txt
mods.json
patches.json
/mods/

# --- Build outputs --------------------------------------------------------------------------------
out/
/dist/
pgo/
__pycache__/
*.AppImage
/tools/gvnet-server/out/
packaging/runtime-paths.nix
vkd3d-proton.cache
perf.data
/*.spv
*.orig

# --- Vendor files you supply yourself -------------------------------------------------------------
